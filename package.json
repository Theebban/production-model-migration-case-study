{
  "name": "production-model-migration-case-study",
  "version": "2.0.0",
  "private": true,
  "description": "A verified production cutover and an independently authored reference implementation of a controlled model migration that now delegates its migration lifecycle to ModelPromote.",
  "license": "MIT",
  "author": "Theebbanraj Asokan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Theebban/production-model-migration-case-study.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint reference-implementation",
    "test": "node --experimental-strip-types --test reference-implementation/tests/*.test.ts",
    "demo": "node --experimental-strip-types reference-implementation/src/demo.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "modelpromote": "0.1.2"
  }
}
